{
  "name": "humane-design",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MercuriusDream/humane-design-language"
  },
  "homepage": "https://humane.mercuriusdream.com",
  "type": "module",
  "workspaces": [
    "system",
    "docs",
    "flagship",
    "landing"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun --filter './*' build",
    "build:site": "vite build",
    "preview": "vite preview",
    "typecheck": "bun --filter './*' typecheck && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun test tests/*.test.mjs",
    "test:browser": "bun tests/browser.mjs",
    "test:safari": "bun tests/safari.mjs"
  }
}
